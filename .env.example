# Database (PostgreSQL in production; SQLite works for local development)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/repo_security_auditor
TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db

# Runtime
APP_ENV=development            # any value other than development/test/local requires SECRET_KEY
SECRET_KEY=                    # >= 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
AUDIT_LOG_FILE=                 # optional: append security audit events (JSON lines) to this file; default stderr
AUTO_MIGRATE=1                 # run `alembic upgrade head` on startup; set 0 when migrations run separately

# Scanning
GITHUB_TOKEN=                  # optional: raises the GitHub API rate limit for repository validation
GITLEAKS_PATH=                 # optional: binary location when not on PATH
SEMGREP_PATH=
SCAN_TIMEOUT_SECONDS=300
MAX_REPOSITORY_BYTES=104857600

# AI explanations (Claude). Enabled automatically when ANTHROPIC_API_KEY is set.
ANTHROPIC_API_KEY=
AI_EXPLANATIONS_ENABLED=
AI_MODEL=claude-opus-5-5
