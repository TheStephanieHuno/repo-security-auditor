# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://auditor:auditor123@localhost:5432/repo_auditor

# Redis Configuration (Scan Job Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication
SECRET_KEY=repo-security-auditor-production-grade-secret-key-minimum-256-bits
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third-Party Integrations
GITHUB_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Scanner Resource Constraints
CLONE_TIMEOUT_SECONDS=60
SCAN_TIMEOUT_SECONDS=300
MAX_CLONE_SIZE_MB=100

# ---- app/ package (Joseph's implementation) ----
APP_ENV=development              # any other value requires SECRET_KEY (>= 32 chars)
AUTO_MIGRATE=1                   # app/ runs Alembic on startup; set 0 and run `alembic upgrade head` to keep audit logs on
CORS_ORIGINS=http://localhost:3000
AUDIT_LOG_FILE=                  # optional: security audit events as JSON lines
GITLEAKS_PATH=                   # optional scanner binary locations
SEMGREP_PATH=
ANTHROPIC_API_KEY=               # optional: AI explanations in app/
